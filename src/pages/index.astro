---
import eventsData from "../data/events.json";

const TIMEZONE = "America/Edmonton";
const SITE_ORIGIN = "https://events.4pointshealth.com";
const FALLBACK_IMAGE = "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=700&auto=format&fit=crop&q=80";

const allEvents = (eventsData && eventsData.events) || [];

function bySection(section, cardStyle) {
  return allEvents
    .filter((e) => e.section === section && (!cardStyle || e.cardStyle === cardStyle))
    .sort((a, b) => a.displayOrder - b.displayOrder);
}

const upcomingEvents = bySection("Upcoming Event");
const professionalDevelopment = bySection("Professional Development");
const weeklyClassCards = bySection("Weekly Class", "Class Card");
const weeklyTeaserCards = bySection("Weekly Class", "Teaser Card");
const wellnessWorkshopCards = bySection("Wellness Workshop");

const dateFmt = new Intl.DateTimeFormat("en-US", { timeZone: TIMEZONE, weekday: "long", month: "long", day: "numeric", year: "numeric" });
const timeFmt = new Intl.DateTimeFormat("en-US", { timeZone: TIMEZONE, hour: "numeric", minute: "2-digit" });
const dayFmt = new Intl.DateTimeFormat("en-US", { timeZone: TIMEZONE, day: "numeric" });
const monthFmt = new Intl.DateTimeFormat("en-US", { timeZone: TIMEZONE, month: "long" });
const yearFmt = new Intl.DateTimeFormat("en-US", { timeZone: TIMEZONE, year: "numeric" });
const weekdayFmt = new Intl.DateTimeFormat("en-US", { timeZone: TIMEZONE, weekday: "long" });

function fmtDateLine(ev) {
  if (!ev.startIso) return null;
  const start = new Date(ev.startIso);
  const end = ev.endIso ? new Date(ev.endIso) : null;
  if (!end || dateFmt.format(start) === dateFmt.format(end)) {
    return `${dateFmt.format(start)} · ${timeFmt.format(start)}`;
  }
  const startMonth = monthFmt.format(start);
  const endMonth = monthFmt.format(end);
  const year = yearFmt.format(start);
  if (startMonth === endMonth) {
    return `${startMonth} ${dayFmt.format(start)}–${dayFmt.format(end)}, ${year}`;
  }
  return `${startMonth} ${dayFmt.format(start)} – ${endMonth} ${dayFmt.format(end)}, ${year}`;
}

function fmtWeeklyLine(ev) {
  if (!ev.startIso) return null;
  const start = new Date(ev.startIso);
  return `${weekdayFmt.format(start)}s · ${timeFmt.format(start)}`;
}

function teaserBadgeClass(text) {
  if (text && text.toLowerCase().includes("special")) return "badge-special";
  return "badge-coming-soon";
}

function teaserCtaStyle(badgeText) {
  if (badgeText && badgeText.toLowerCase().includes("special")) {
    return "display: inline-block; background: rgba(200,169,81,0.25); color: #f5d98a; font-size: 13px; font-weight: 600; padding: 10px 24px; border-radius: 30px; border: 1px solid rgba(200,169,81,0.5); text-decoration: none;";
  }
  return "display: inline-block; background: rgba(255,255,255,0.15); color: white; font-size: 13px; font-weight: 600; padding: 10px 24px; border-radius: 30px; border: 1px solid rgba(255,255,255,0.3); text-decoration: none;";
}

function jsonLdFor(ev) {
  const priceMatch = ev.price && String(ev.price).match(/([0-9]+(\.[0-9]+)?)/);
  const ld = {
    "@context": "https://schema.org",
    "@type": "Event",
    "name": ev.title,
    "startDate": ev.startIso,
    "endDate": ev.endIso,
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "eventStatus": "https://schema.org/EventScheduled",
    "location": {
      "@type": "Place",
      "name": "4 Points Health and Wellness",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "11634 142 Street NW",
        "addressLocality": "Edmonton",
        "addressRegion": "AB",
        "postalCode": "T5M 1V4",
        "addressCountry": "CA"
      }
    },
    "description": ev.description,
    "organizer": { "@type": "Organization", "name": "4 Points Health and Wellness", "url": "https://www.4pointshealth.com" }
  };
  if (ev.image) ld.image = [ev.image.startsWith("http") ? ev.image : `${SITE_ORIGIN}${ev.image}`];
  if (priceMatch) {
    ld.offers = {
      "@type": "Offer",
      "price": priceMatch[1],
      "priceCurrency": "CAD",
      "availability": "https://schema.org/InStock",
      "url": ev.bookingLink || SITE_ORIGIN
    };
  }
  return ld;
}

const jsonLdEvents = allEvents.filter((e) => e.startIso && e.endIso).map(jsonLdFor);

function absImage(img) {
  if (!img) return null;
  return img.startsWith("http") ? img : `${SITE_ORIGIN}${img}`;
}

const shareImage =
  (upcomingEvents[0] && absImage(upcomingEvents[0].image)) ||
  (professionalDevelopment[0] && absImage(professionalDevelopment[0].image)) ||
  `${SITE_ORIGIN}/4Pointslogo.jpg`;

    <style>
      /* Treatments dropdown */
      .nav-dropdown { position: relative; }
      .dropdown-trigger {
        background: none; border: none; cursor: pointer;
        color: #4a4540; font-size: 14px; font-weight: 500;
        font-family: inherit; padding: 0;
        display: flex; align-items: center; gap: 4px;
      }
      .dropdown-trigger:hover { color: #1a2744; }
      .dropdown-menu {
        display: none;
        position: absolute;
        top: calc(100% + 16px);
        left: 50%;
        transform: translateX(-50%);
        background: white;
        border-radius: 12px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.18);
        padding: 28px 32px;
        min-width: 580px;
        z-index: 200;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        border-top: 3px solid #1a2744;
      }
      .nav-dropdown:hover .dropdown-menu { display: grid; }
      .dropdown-heading { font-size: 11px; font-weight: 700; color: #1a2744; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.8px; }
      .dropdown-sub { font-size: 12px; color: #4a70a8; font-style: italic; display: block; margin-bottom: 14px; }
      .dropdown-menu ul { list-style: none; padding: 0; margin: 0; }
      .dropdown-menu li { margin-bottom: 10px; }
      .dropdown-menu a { color: #4a4540; text-decoration: none; font-size: 14px; display: flex; align-items: center; gap: 8px; }
      .dropdown-menu a:hover { color: #1a2744; font-weight: 600; }
      .dropdown-menu a::before { content: '•'; color: #c8a951; font-size: 12px; flex-shrink: 0; }

      /* Hamburger button */
      .hamburger-btn {
        display: none; background: none; border: none;
        cursor: pointer; padding: 4px; flex-direction: column; gap: 5px;
      }
      .hamburger-btn span { display: block; width: 24px; height: 2px; background: #1a2744; }

      /* Mobile nav overlay */
      .mobile-nav {
        display: none; position: fixed; inset: 0;
        background: white; z-index: 500;
        flex-direction: column; padding: 24px 32px; overflow-y: auto;
      }
      .mobile-nav.open { display: flex; }
      .mobile-nav-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; }
      .mobile-nav-close { background: none; border: none; font-size: 28px; cursor: pointer; color: #1a2744; line-height: 1; }
      .mobile-nav > a { display: block; color: #1a2744; font-size: 18px; font-weight: 600; text-decoration: none; padding: 14px 0; border-bottom: 1px solid #e8e4df; }
      .mobile-section-heading { font-size: 11px; font-weight: 700; color: #4a70a8; letter-spacing: 1px; text-transform: uppercase; padding: 16px 0 8px; }
      .mobile-sub-links a { display: block; color: #4a4540; font-size: 15px; text-decoration: none; padding: 8px 0 8px 12px; }
      .mobile-sub-links a:hover { color: #1a2744; }
      .mobile-book-btn { display: block; background: #1a2744; color: white !important; text-align: center; padding: 14px 28px; border-radius: 30px; font-size: 15px; font-weight: 700; margin-top: 28px; text-decoration: none !important; }

      @media (max-width: 768px) {
        .hamburger-btn { display: flex; }
        .desktop-nav { display: none !important; }
      }
    </style>
  </head>

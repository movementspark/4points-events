    <style>
      /* Treatments dropdown */
      .nav-dropdown { position: relative; }
      .dropdown-trigger {
        background: none; border: none; cursor: pointer;
        color: #3a4a5c; font-size: 14px; font-weight: 500;
        font-family: inherit; padding: 0;
        display: flex; align-items: center; gap: 4px;
      }
      .dropdown-trigger:hover { color: #4a70a8; }
      .dropdown-menu {
        display: none;
        position: absolute;
        top: calc(100% + 16px);
        left: 50%;
        transform: translateX(-50%);
        background: white;
        border-radius: 12px;
        box-shadow: 0 8px 40px rgba(0,0,0,0.18);
        padding: 28px 32px;
        min-width: 580px;
        z-index: 200;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        border-top: 3px solid #4a70a8;
      }
      .nav-dropdown:hover .dropdown-menu { display: grid; }
      .dropdown-heading { font-size: 11px; font-weight: 700; color: #4a70a8; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.8px; }
      .dropdown-sub { font-size: 12px; color: #4a70a8; font-style: italic; display: block; margin-bottom: 14px; }
      .dropdown-menu ul { list-style: none; padding: 0; margin: 0; }
      .dropdown-menu li { margin-bottom: 10px; }
      .dropdown-menu a { color: #3a4a5c; text-decoration: none; font-size: 14px; display: flex; align-items: center; gap: 8px; }
      .dropdown-menu a:hover { color: #4a70a8; font-weight: 600; }
      .dropdown-menu a::before { content: '•'; color: #c8a951; font-size: 12px; flex-shrink: 0; }

      /* Hamburger button */
      .hamburger-btn {
        display: none; background: none; border: none;
        cursor: pointer; padding: 4px; flex-direction: column; gap: 5px;
      }
      .hamburger-btn span { display: block; width: 24px; height: 2px; background: #4a70a8; }

      /* Mobile nav overlay */
      .mobile-nav {
        display: none; position: fixed; inset: 0;
        background: white; z-index: 500;
        flex-direction: column; padding: 24px 32px; overflow-y: auto;
      }
      .mobile-nav.open { display: flex; }
      .mobile-nav-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; }
      .mobile-nav-close { background: none; border: none; font-size: 28px; cursor: pointer; color: #4a70a8; line-height: 1; }
      .mobile-nav > a { display: block; color: #4a70a8; font-size: 18px; font-weight: 600; text-decoration: none; padding: 14px 0; border-bottom: 1px solid #dde5ec; }
      .mobile-section-heading { font-size: 11px; font-weight: 700; color: #4a70a8; letter-spacing: 1px; text-transform: uppercase; padding: 16px 0 8px; }
      .mobile-sub-links a { display: block; color: #3a4a5c; font-size: 15px; text-decoration: none; padding: 8px 0 8px 12px; }
      .mobile-sub-links a:hover { color: #4a70a8; }
      .mobile-book-btn { display: block; background: #4a70a8; color: white !important; text-align: center; padding: 14px 28px; border-radius: 30px; font-size: 15px; font-weight: 700; margin-top: 28px; text-decoration: none !important; }

      /* Event cards */
      .event-card {
        border-radius: 12px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-height: 420px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.12);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        background-size: cover;
        background-position: center;
        position: relative;
      }
      .event-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 36px rgba(0,0,0,0.18);
      }
      .event-card-overlay {
        position: absolute; inset: 0;
        background: linear-gradient(180deg, rgba(74,112,168,0.05) 0%, rgba(35,63,110,0.88) 60%);
      }
      .event-card-content {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        height: 100%;
      }
      .event-card-badge {
        padding: 16px 18px;
      }
      .badge {
        display: inline-block;
        font-size: 11px; font-weight: 700; letter-spacing: 0.5px;
        padding: 5px 14px; border-radius: 20px;
      }
      .badge-coming-soon {
        background: rgba(200,169,81,0.9);
        color: #1a1a00;
        border: 1px solid rgba(200,169,81,1);
      }
      .badge-special {
        background: rgba(200,169,81,0.35);
        color: #f5d98a;
        border: 1px solid rgba(200,169,81,0.5);
      }
      .event-card-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 22px 26px;
        color: white;
      }

      /* Coming soon section */
      .coming-soon-banner {
        background: linear-gradient(135deg, #4a70a8 0%, #6a94c8 100%);
        border-radius: 16px;
        padding: 56px 48px;
        text-align: center;
        position: relative;
        overflow: hidden;
      }
      .coming-soon-banner::before {
        content: '';
        position: absolute; inset: 0;
        background-image: radial-gradient(circle at 20% 50%, rgba(74,143,190,0.15) 0%, transparent 60%),
                          radial-gradient(circle at 80% 20%, rgba(200,169,81,0.1) 0%, transparent 50%);
      }
      .coming-soon-banner > * { position: relative; z-index: 1; }

      @media (max-width: 768px) {
        .hamburger-btn { display: flex; }
        .desktop-nav { display: none !important; }
        .hero-split { grid-template-columns: 1fr !important; }
        .hero-image-panel { min-height: 280px; }
        .footer-grid { grid-template-columns: 1fr 1fr !important; gap: 32px !important; }
      }
      @media (max-width: 480px) {
        .footer-grid { grid-template-columns: 1fr !important; }
      }
    </style>
  </head>
